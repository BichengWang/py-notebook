{"decision":"Allow","diagnostics":{"errors":[],"reason":["routers-set-priority"]},"engine":"cedar","entities":[{"attrs":{},"parents":[],"uid":{"id":"routers","type":"Group"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"alice","type":"User"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"bob","type":"User"}},{"attrs":{},"parents":[],"uid":{"id":"mallory","type":"User"}}],"policies":{"format":"cedar","text":"// Ticket-routing policy used to record the Cedar fixtures. Cedar answers Allow or Deny;\n// whether a human must review is decided by the built-in policy and the record combines them.\n\n@id(\"routers-reassign-to-open-destinations\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context.requested == \"support\" || context.requested == \"engineering\" };\n\n@id(\"routers-set-priority\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"set_ticket_priority\",\n    resource\n)\nwhen { [\"low\", \"normal\", \"high\", \"urgent\"].contains(context.requested) };\n\n@id(\"legal-tickets-stay-in-legal\")\nforbid (\n    principal,\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context has current && context.current == \"legal\" };\n"},"request":{"action":"Action::\"set_ticket_priority\"","context":{"current":"high","proposal_sha256":"31f6b9b0765d82a36304e89d22a6b65c564fc1e139ffb4d641a2e1c992496fc3","requested":"urgent"},"principal":"User::\"alice\"","resource":"Ticket::\"T-214\""}}