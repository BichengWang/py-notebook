{"created_at":"2026-10-20T00:25:10.356797+00:00","evaluation":{"reasons":["destination_requires_review","opa:destination_needs_review"],"verdict":"REVIEW"},"events":[{"at":"2026-10-20T00:25:10.356797+00:00","event":"SUBMITTED"},{"at":"2026-10-20T00:25:10.398968+00:00","event":"APPROVED"},{"at":"2026-10-20T00:25:10.441523+00:00","event":"EXECUTED"}],"external_policy":{"bundles":{"bundle":{"revision":"ticket-routing-2026-10-19.1"}},"data":{},"decision_id":"614e526d-000b-430b-bf2c-6a7266f3c436","engine":"opa","input":{"action":"reassign_ticket","proposed_by":"alice","recommendation":{"action":"reassign_ticket","destination":"engineering","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-202"},"ticket":{"department":"intake","id":"T-202","revision":0}},"labels":{"id":"8263a464-de81-4c3a-bd44-0f980ede03ee","version":"1.21.2"},"modules":{"routing.rego":"package ticket.routing\n\n# Ticket-routing policy used to record the OPA fixtures. It is deliberately small:\n# only listed routers may act, and the destinations and priorities that need a human\n# are marked REVIEW. Anything else is denied.\n\ndefault decision := {\"verdict\": \"DENY\", \"reasons\": [\"no_rule_matched\"]}\n\nrouters := {\"alice\", \"bob\"}\n\nopen_destinations := {\"support\"}\n\nreview_destinations := {\"engineering\"}\n\nopen_priorities := {\"low\", \"normal\", \"high\"}\n\nreview_priorities := {\"urgent\"}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_reassigns_to_open_destination\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in open_destinations\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"destination_needs_review\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in review_destinations\n}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_sets_open_priority\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in open_priorities\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"priority_needs_review\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in review_priorities\n}\n"},"path":"ticket/routing/decision","result":{"reasons":["destination_needs_review"],"verdict":"REVIEW"},"timestamp":"2026-10-20T00:25:08.985313Z"},"external_policy_sha256":"79a5e9ecf8bea8a44565934e248b6e9c124f4641752b32aac528350baf45c048","id":"93d400ec-710d-4e9d-8083-a45c5a94b208","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"alice","recommendation":{"action":"reassign_ticket","destination":"engineering","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-202"},"result":{"department":"engineering","id":"T-202","revision":1},"review":{"at":"2026-10-20T00:25:10.398968+00:00","decision":"APPROVED","note":"checked the frozen decision","reviewer":"bob"},"schema_version":5,"status":"EXECUTED","ticket":{"department":"intake","id":"T-202","revision":0}}