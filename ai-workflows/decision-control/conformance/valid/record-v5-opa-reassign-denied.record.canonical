{"created_at":"2026-10-20T00:25:10.644889+00:00","evaluation":{"reasons":["opa:no_rule_matched"],"verdict":"DENY"},"events":[{"at":"2026-10-20T00:25:10.644889+00:00","event":"SUBMITTED"}],"external_policy":{"bundles":{"bundle":{"revision":"ticket-routing-2026-10-19.1"}},"data":{},"decision_id":"869728a4-0a97-4ac7-8cbf-02794a4f7a14","engine":"opa","input":{"action":"reassign_ticket","proposed_by":"mallory","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-203"},"ticket":{"department":"intake","id":"T-203","revision":0}},"labels":{"id":"8263a464-de81-4c3a-bd44-0f980ede03ee","version":"1.21.2"},"modules":{"routing.rego":"package ticket.routing\n\n# Ticket-routing policy used to record the OPA fixtures. It is deliberately small:\n# only listed routers may act, and the destinations and priorities that need a human\n# are marked REVIEW. Anything else is denied.\n\ndefault decision := {\"verdict\": \"DENY\", \"reasons\": [\"no_rule_matched\"]}\n\nrouters := {\"alice\", \"bob\"}\n\nopen_destinations := {\"support\"}\n\nreview_destinations := {\"engineering\"}\n\nopen_priorities := {\"low\", \"normal\", \"high\"}\n\nreview_priorities := {\"urgent\"}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_reassigns_to_open_destination\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in open_destinations\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"destination_needs_review\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in review_destinations\n}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_sets_open_priority\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in open_priorities\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"priority_needs_review\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in review_priorities\n}\n"},"path":"ticket/routing/decision","result":{"reasons":["no_rule_matched"],"verdict":"DENY"},"timestamp":"2026-10-20T00:25:09.06804Z"},"external_policy_sha256":"1bb683167be0588707e8b02d6ea0a058356166723c90474ed3aa7679a08f149f","id":"ab0e9005-386d-459c-bdb5-524aa2b67e1c","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"mallory","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-203"},"result":null,"review":null,"schema_version":5,"status":"DENIED","ticket":{"department":"intake","id":"T-203","revision":0}}