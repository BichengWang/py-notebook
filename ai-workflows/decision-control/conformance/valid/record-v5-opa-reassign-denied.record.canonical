:= {\"verdict\": \"REVIEW\", \"reasons\": [\"priority_needs_review\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in review_priorities\n}\n"},"path":"ticket/routing/decision","result":{"reasons":["no_rule_matched"],"verdict":"DENY"},"timestamp":"2026-10-19T23:58:43.706902Z"},"external_policy_sha256":"11d1f7858cbca1cba93b6853b4f18cd6ab7b36544a6b2c11705069ca866256ce","id":"b560798c-e61d-40d0-9717-ce1cd345e759","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"mallory","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-203"},"result":null,"review":null,"schema_version":5,"status":"DENIED","ticket":{"department":"intake","id":"T-203","revision":0}}