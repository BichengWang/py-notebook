== \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in open_priorities\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"priority_needs_review\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in review_priorities\n}\n"},"path":"ticket/routing/decision","result":{"reasons":["router_sets_open_priority"],"verdict":"ALLOW"},"timestamp":"2026-10-19T23:58:43.782645Z"},"external_policy_sha256":"18fe7e2e1c6bc631c48efcd9b5443a304dd30961bf7faca004d1c5eb53a93b32","id":"1702de8a-ad1e-4f40-a390-3185d3bf9a84","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"alice","recommendation":{"action":"set_ticket_priority","model":"recorded-fixture-not-a-provider","priority":"high","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-204"},"result":{"department":"support","id":"T-204","priority":"high","revision":1},"review":null,"schema_version":5,"status":"EXECUTED","ticket":{"department":"support","id":"T-204","priority":"normal","revision":0}}