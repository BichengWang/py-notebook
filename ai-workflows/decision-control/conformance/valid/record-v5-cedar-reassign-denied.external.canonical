{"decision":"Deny","diagnostics":{"errors":[],"reason":[]},"engine":"cedar","entities":[{"attrs":{},"parents":[],"uid":{"id":"routers","type":"Group"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"alice","type":"User"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"bob","type":"User"}},{"attrs":{},"parents":[],"uid":{"id":"mallory","type":"User"}}],"policies":{"format":"cedar","text":"// Ticket-routing policy used to record the Cedar fixtures. Cedar answers Allow or Deny;\n// whether a human must review is decided by the built-in policy and the record combines them.\n\n@id(\"routers-reassign-to-open-destinations\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context.requested == \"support\" || context.requested == \"engineering\" };\n\n@id(\"routers-set-priority\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"set_ticket_priority\",\n    resource\n)\nwhen { [\"low\", \"normal\", \"high\", \"urgent\"].contains(context.requested) };\n\n@id(\"legal-tickets-stay-in-legal\")\nforbid (\n    principal,\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context has current && context.current == \"legal\" };\n"},"request":{"action":"Action::\"reassign_ticket\"","context":{"current":"intake","proposal_sha256":"7a4fe0b5cc23ad3228b5efc97a408a3605e8661d11e40b74bb6b43c031ef55a1","requested":"support"},"principal":"User::\"mallory\"","resource":"Ticket::\"T-212\""}}