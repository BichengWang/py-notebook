{"created_at":"2026-10-19T23:58:45.862159+00:00","evaluation":{"reasons":["cedar:no_permit_applied"],"verdict":"DENY"},"events":[{"at":"2026-10-19T23:58:45.862159+00:00","event":"SUBMITTED"}],"external_policy":{"decision":"Deny","diagnostics":{"errors":[],"reason":[]},"engine":"cedar","entities":[{"attrs":{},"parents":[],"uid":{"id":"routers","type":"Group"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"alice","type":"User"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"bob","type":"User"}},{"attrs":{},"parents":[],"uid":{"id":"mallory","type":"User"}}],"policies":{"format":"cedar","text":"// Ticket-routing policy used to record the Cedar fixtures. Cedar answers Allow or Deny;\n// whether a human must review is decided by the built-in policy and the record combines them.\n\n@id(\"routers-reassign-to-open-destinations\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context.requested == \"support\" || context.requested == \"engineering\" };\n\n@id(\"routers-set-priority\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"set_ticket_priority\",\n    resource\n)\nwhen { [\"low\", \"normal\", \"high\", \"urgent\"].contains(context.requested) };\n\n@id(\"legal-tickets-stay-in-legal\")\nforbid (\n    principal,\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context has current && context.current == \"legal\" };\n"},"request":{"action":"Action::\"reassign_ticket\"","context":{"current":"intake","requested":"support"},"principal":"User::\"mallory\"","resource":"Ticket::\"T-212\""}},"external_policy_sha256":"b7b857ae28ee29ee8b25034f81679f35fe9091290e26438c9ef12b070e057624","id":"c16191b5-912e-472a-bb4c-2dbf4af6ef36","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"mallory","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-212"},"result":null,"review":null,"schema_version":5,"status":"DENIED","ticket":{"department":"intake","id":"T-212","revision":0}}