{"created_at":"2026-10-19T23:58:46.241922+00:00","evaluation":{"reasons":["priority_requires_review"],"verdict":"REVIEW"},"events":[{"at":"2026-10-19T23:58:46.241922+00:00","event":"SUBMITTED"},{"at":"2026-10-19T23:58:46.281650+00:00","event":"APPROVED"},{"at":"2026-10-19T23:58:46.321628+00:00","event":"EXECUTED"}],"external_policy":{"decision":"Allow","diagnostics":{"errors":[],"reason":["routers-set-priority"]},"engine":"cedar","entities":[{"attrs":{},"parents":[],"uid":{"id":"routers","type":"Group"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"alice","type":"User"}},{"attrs":{},"parents":[{"id":"routers","type":"Group"}],"uid":{"id":"bob","type":"User"}},{"attrs":{},"parents":[],"uid":{"id":"mallory","type":"User"}}],"policies":{"format":"cedar","text":"// Ticket-routing policy used to record the Cedar fixtures. Cedar answers Allow or Deny;\n// whether a human must review is decided by the built-in policy and the record combines them.\n\n@id(\"routers-reassign-to-open-destinations\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context.requested == \"support\" || context.requested == \"engineering\" };\n\n@id(\"routers-set-priority\")\npermit (\n    principal in Group::\"routers\",\n    action == Action::\"set_ticket_priority\",\n    resource\n)\nwhen { [\"low\", \"normal\", \"high\", \"urgent\"].contains(context.requested) };\n\n@id(\"legal-tickets-stay-in-legal\")\nforbid (\n    principal,\n    action == Action::\"reassign_ticket\",\n    resource\n)\nwhen { context has current && context.current == \"legal\" };\n"},"request":{"action":"Action::\"set_ticket_priority\"","context":{"current":"high","requested":"urgent"},"principal":"User::\"alice\"","resource":"Ticket::\"T-214\""}},"external_policy_sha256":"c8668f92a457c0cb96824a5abddf5a02f2bd220513e7192bd9e741130309ef67","id":"0967f9f0-717a-46b9-9951-23382de0dbd9","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"alice","recommendation":{"action":"set_ticket_priority","model":"recorded-fixture-not-a-provider","priority":"urgent","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-214"},"result":{"department":"support","id":"T-214","priority":"urgent","revision":1},"review":{"at":"2026-10-19T23:58:46.281650+00:00","decision":"APPROVED","note":"checked the frozen decision","reviewer":"bob"},"schema_version":5,"status":"EXECUTED","ticket":{"department":"support","id":"T-214","priority":"high","revision":0}}