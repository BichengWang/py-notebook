{"created_at":"2026-10-19T23:58:44.695795+00:00","evaluation":{"reasons":["policy_permits_reassignment","opa:router_reassigns_to_open_destination"],"verdict":"ALLOW"},"events":[{"at":"2026-10-19T23:58:44.695795+00:00","event":"SUBMITTED"},{"at":"2026-10-19T23:58:44.732961+00:00","event":"EXECUTED"}],"external_policy":{"bundles":{"bundle":{"revision":"ticket-routing-2026-10-19.1"}},"data":{},"decision_id":"12b3ea1b-0ccf-4344-9212-1f619f6d99e1","engine":"opa","input":{"action":"reassign_ticket","proposed_by":"alice","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-201"},"ticket":{"department":"intake","id":"T-201","revision":0}},"labels":{"id":"f438e1d5-55c7-47d9-a3bc-a984fa1862ed","version":"1.21.2"},"modules":{"routing.rego":"package ticket.routing\n\n# Ticket-routing policy used to record the OPA fixtures. It is deliberately small:\n# only listed routers may act, and the destinations and priorities that need a human\n# are marked REVIEW. Anything else is denied.\n\ndefault decision := {\"verdict\": \"DENY\", \"reasons\": [\"no_rule_matched\"]}\n\nrouters := {\"alice\", \"bob\"}\n\nopen_destinations := {\"support\"}\n\nreview_destinations := {\"engineering\"}\n\nopen_priorities := {\"low\", \"normal\", \"high\"}\n\nreview_priorities := {\"urgent\"}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_reassigns_to_open_destination\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in open_destinations\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"destination_needs_review\"]} if {\n\tinput.action == \"reassign_ticket\"\n\tinput.proposed_by in routers\n\tinput.recommendation.destination in review_destinations\n}\n\ndecision := {\"verdict\": \"ALLOW\", \"reasons\": [\"router_sets_open_priority\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in open_priorities\n}\n\ndecision := {\"verdict\": \"REVIEW\", \"reasons\": [\"priority_needs_review\"]} if {\n\tinput.action == \"set_ticket_priority\"\n\tinput.proposed_by in routers\n\tinput.recommendation.priority in review_priorities\n}\n"},"path":"ticket/routing/decision","result":{"reasons":["router_reassigns_to_open_destination"],"verdict":"ALLOW"},"timestamp":"2026-10-19T23:58:43.557024Z"},"external_policy_sha256":"17d899ae3762606ec67fb381b66021a1d6982f95b4079730fed9caada4a5eea9","id":"0d806b8b-3204-4a2d-9f3c-5ddd884c3459","policy":{"allowed_destinations":["support","engineering","legal"],"allowed_priorities":["low","normal","high","urgent"],"min_probability":0.8,"review_destinations":["engineering"],"review_priorities":["urgent"],"reviewers":["bob","carol"],"version":"ticket-routing-fixture-1"},"policy_sha256":"7236899f82f6bdfbbd02fa56d431c87e8b80270d5e50c3c3e2b1ac4048d78240","produced_by":{"name":"decisioncontrol","version":"0.1.0"},"proposed_by":"alice","recommendation":{"action":"reassign_ticket","destination":"support","model":"recorded-fixture-not-a-provider","probability":0.95,"question_version":"routing-question-1","refused":false,"ticket_id":"T-201"},"result":{"department":"support","id":"T-201","revision":1},"review":null,"schema_version":5,"status":"EXECUTED","ticket":{"department":"intake","id":"T-201","revision":0}}